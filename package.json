{
  "name": "factory-twin",
  "version": "0.1.0",
  "description": "3D digital twin of a production hall with an AI agent (recorded and live modes).",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:live": "vite --configLoader runner --mode live",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "recordings:build": "tsx scripts/build-recordings.ts",
    "record": "tsx scripts/record-live.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts --configLoader runner"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.57.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
